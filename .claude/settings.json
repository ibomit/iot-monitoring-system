{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.crt)",
      "Read(./**/secrets/**)",
      "Read(./.venv/**)",
      "Read(./**/venv/**)",
      "Read(./**/__pycache__/**)",
      "Read(./**/.pytest_cache/**)",
      "Read(./**/.mypy_cache/**)",
      "Read(./**/.ruff_cache/**)",
      "Read(./**/htmlcov/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/build/**)",
      "Read(./**/.vite/**)",
      "Read(./**/coverage/**)",
      "Read(./**/.pio/**)",
      "Read(./**/*.bin)",
      "Read(./**/*.elf)",
      "Read(./**/*.hex)",
      "Read(./**/*.sqlite)",
      "Read(./**/*.sqlite3)",
      "Read(./**/*.db)",
      "Read(./**/*.log)"
    ]
  }
}
